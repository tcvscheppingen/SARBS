#!/bin/sh
# Menu for locking, leaving sway, sleep, reboot and shutdown. A Wayland version
# of sysact from Luke Smith's voidrice: https://github.com/LukeSmithxyz/voidrice

menu() {
    wmenu -i -p "$1" -f 'JetBrainsMono Nerd Font 10' \
        -N 121212 -n d0d0d0 -M 8a7d74 -m 121212 -S 8a7d74 -s 121212
}

# On Artix, elogind's loginctl does what systemctl does on systemd distros
if [ -d /run/systemd/system ]; then
    ctl=systemctl
else
    ctl=loginctl
fi

lock() {
    playerctl --all-players pause 2> /dev/null
    swaylock
}

# Turn the displays off until the next key press or mouse movement. $PPID
# expands in the shell swayidle starts, so it is swayidle itself.
# shellcheck disable=SC2016
display_off() {
    swayidle -w timeout 1 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"; kill $PPID' &
}

case "$(printf 'lock\nleave sway\nrenew sway\nsleep\nreboot\nshutdown\ndisplay off\n' | menu 'Action:')" in
    'lock') lock ;;
    'leave sway') swaymsg exit ;;
    'renew sway') swaymsg reload ;;
    # swayidle locks the screen before the laptop sleeps
    'sleep') $ctl suspend -i ;;
    'reboot') $ctl reboot -i ;;
    'shutdown') $ctl poweroff -i ;;
    'display off') display_off ;;
    *) exit 1 ;;
esac
