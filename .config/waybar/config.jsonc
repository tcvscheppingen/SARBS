{
    "layer": "top",
    "position": "top",
    "spacing": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-right": [
        "network",
        "custom/recording",
        "pulseaudio",
        "battery",
        "memory",
        "clock#date",
        "clock#time",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll-wraparound": true
    },

    "network": {
        "format-wifi": "wifi {essid} {signalStrength}%",
        "format-ethernet": "eth {ifname}",
        "format-disconnected": "wifi down",
        "tooltip-format": "{ifname} {ipaddr}/{cidr}"
    },

    // Set by ~/.local/bin/wmenurecord, which sends signal 9 when it changes
    "custom/recording": {
        "exec": "cat \"$XDG_RUNTIME_DIR/recording.icon\" 2> /dev/null",
        "interval": "once",
        "signal": 9
    },

    "pulseaudio": {
        "format": "| vol {volume}%",
        "format-bluetooth": "| vol {volume}% bt",
        "format-muted": "| vol mute",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },

    // Hidden on machines without a battery
    "battery": {
        "format": "| bat {capacity}%",
        "format-charging": "| bat {capacity}% chr",
        "format-plugged": "| bat {capacity}% ac",
        "format-full": "| bat full",
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "memory": {
        "format": "| mem {used:0.1f}G",
        "interval": 2
    },

    "clock#date": {
        "format": "| {:%a %d %b}",
        "tooltip": false
    },

    "clock#time": {
        "format": "| {:%H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 4
    }
}
